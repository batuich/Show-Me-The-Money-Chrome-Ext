					"justifyContent": "center",
					"alignItems": "center",
					"color": "#B5B5B6",
					"fontSize": 12
				}
			},
			"day": {
				"default": {
					"width": "22px",
					"height": "22px",
					"display": "flex",
					"justifyContent": "center",
					"alignItems": "center",
					"borderRadius": "4px",
					"cursor": "pointer",
					"color": "rgba(255, 255, 255, 1)",
					"fontSize": 13
				},
				"hover": {
					"backgroundColor": "rgba(45, 43, 35, 1)"
				},
				"today": {
					"backgroundColor": "rgba(129, 160, 193, 1)",
					"color": "#000"
				},
				"disabled": {
					"color": "#7A7A7A"
				}
			}
		},
		"menu": {
			"doneTextColor": "#9B9B9B",
			"menuContainer": {
				"default": {
					"width": 240,
					"padding": 0,
