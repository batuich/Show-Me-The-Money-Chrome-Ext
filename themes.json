{
"cursor": {
		"base": {
			"default": {
				"fontFamily": "'Inter', 'SF Pro Text', sans-serif"
			}
		},
		"common": {
			"spacing": "4px"
		},
		"labels": {
			"missingData": {
				"text": "Not enough data for selected period"
			}
		},
		"highlight": {
			"default": {
				"border": "2px solid #4A90E2",
				"background": "rgba(74, 144, 226, 0.1)",
				"transition": "all 0.2s ease-in-out"
			}
		},
		"panel": {
			"default": {
				"backgroundColor": "#13120A",
				"border": "none",
				"color": "#FFF",
				"padding": "2px",
				"borderRadius": 6,
				"fontSize": 13
			}
		},
		"dragHandle": {
			"default": {
				"backgroundColor": "#1E1C15",
				"padding": "8px 2px",
				"borderRadius": 4
			},
			"hover": {
				"backgroundColor": "#25231C"
			}
		},
		"dragHandleDot": {
			"default": {
				"backgroundColor": "#5D5D5D"
