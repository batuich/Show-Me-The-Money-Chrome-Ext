					"color": "#FFF",
					"borderRadius": 0,
					"fontSize": 13,
					"fontFamily": "'Inter', 'SF Pro Text', sans-serif"
				}
			},
			"menuToggleRow": {
				"default": {
					"display": "flex",
					"alignItems": "center",
					"justifyContent": "space-between",
					"padding": "6px",
					"marginBottom": 0,
					"gap": 0
				}
			},
			"menuToggleText": {
				"default": {
					"color": "#FFF",
					"fontSize": 13,
					"fontFamily": "'Inter', 'SF Pro Text', sans-serif",
					"padding": 6
				}
			},
			"menuToggleButton": {
				"default": {
					"backgroundColor": "#2D2B23",
					"border": "none",
					"padding": 6,
					"cursor": "pointer",
					"display": "flex",
					"alignItems": "center",
					"justifyContent": "center",
					"borderRadius": 4
				},
				"hover": {
					"backgroundColor": "#3F3D37",
					"borderRadius": 4
				}
			},
			"menuButtonWrapper": {
				"default": {
					"padding": 8,
					"marginBottom": 0,
					"borderTop": "1px solid #323438"
				}
			},
			"menuButton": {
				"default": {
					"width": "100%",
					"backgroundColor": "#2D2B23",
					"color": "#FFFFFF",
					"padding": "8px 10px",
					"borderRadius": 4,
					"fontSize": 13,
					"fontFamily": "'Inter', 'SF Pro Text', sans-serif",
					"margin": 0,
        "lineHeight": 1,
        "display": "block",
        "verticalAlign": "top"
				},
				"hover": {
					"backgroundColor": "#3F3D37",
					"color": "#fff"
				}
			},
			"menuHelpBlock": {
				"default": {
					"marginBottom": 6,
					"padding": 6,
					"backgroundColor": "transparent",
					"borderRadius": 0,
					"borderTop": "1px solid #323438"
				}
			},
			"menuHelpTitle": {
				"default": {
					"color": "#FFF",
					"fontSize": 13,
					"fontWeight": 400,
					"padding": "0px 6px",
					"fontFamily": "'Inter', 'SF Pro Text', sans-serif"
				}
			},
			"menuHelpText": {
				"default": {
					"color": "#B5B5B6",
					"fontSize": 12,
					"lineHeight": 1.4,
					"padding": "0px 6px",
					"fontFamily": "'Inter', 'SF Pro Text', sans-serif"
				}
			}
		}
