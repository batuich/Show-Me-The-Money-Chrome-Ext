		"button": {
			"default": {
				"backgroundColor": "transparent",
				"color": "#B5B5B6",
				"padding": "6px 10px",
				"borderRadius": 4
			},
			"hover": {
				"backgroundColor": "#25231C",
				"color": "#fff"
			},
			"active": {
				"backgroundColor": "#1E1C15",
				"color": "#fff"
			}
		},
		"panelSinceButton": {
			"default": {
				"backgroundColor": "#1B1912",
				"color": "#FFFFFF",
				"padding": "6px 10px",
				"borderRadius": 4
			},
			"hover": {
				"backgroundColor": "#25231C",
				"color": "#fff"
			},
			"active": {
				"backgroundColor": "#1E1C15",
				"color": "#fff"
			}
		},
		"totalBlock": {
			"default": {
				"backgroundColor": "transparent",
				"borderRadius": 4,
				"padding": "6px 6px"
			}
		},
		"totalLabel": {
			"default": {
				"color": "#FFF",
				"fontWeight": 400
			}
		},
		"totalValue": {
			"default": {
				"color": "#878787",
				"fontWeight": 400
			}
		},
		"missingDataContainer": {
			"default": {}
		},
		"missingDataLabel": {
			"default": {
				"color": "#ff5555",
				"fontSize": 12,
				"fontWeight": 400,
				"textAlign": "center"
			}
		},
		"tooltip": {
			"default": {
				"backgroundColor": "#1E1C15",
				"color": "#fff",
				"fontSize": 12,
				"padding": "4px 4px",
				"borderRadius": 4,
				"fontFamily": "'Inter', 'SF Pro Text', sans-serif"
			}
		},
		"calendar": {
			"container": {
				"default": {
					"backgroundColor": "rgba(27, 25, 18, 1)",
					"width": "auto",
					"display": "flex",
					"flexDirection": "column",
					"alignItems": "flex-start",
					"gap": "4px",
					"padding": "16px",
					"borderRadius": "10px",
					"border": "1px solid rgba(33, 31, 24, 1)"
				}
			},
			"title": {
				"default": {
					"display": "flex",
					"alignItems": "center",
					"gap": "2px",
					"alignSelf": "stretch"
				}
			},
			"month": {
				"default": {
					"display": "flex",
					"alignItems": "center",
					"gap": "10px",
					"padding": "2px 0",
					"flexGrow": 1
				}
			},
			"monthText": {
				"default": {
					"color": "rgba(255, 255, 255, 1)",
					"lineHeight": "18px",
					"fontFamily": "SF Pro Display",
					"fontSize": 13,
					"fontWeight": 400
				}
			},
			"navButtons": {
				"default": {
					"display": "flex",
					"alignItems": "center",
					"gap": "4px"
				}
