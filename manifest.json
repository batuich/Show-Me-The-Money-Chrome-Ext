{
  "manifest_version": 3,
  "name": "Show Me The Money",
  "version": "1.0",
  "description": "Automatically summarizes credit usage on specified websites.",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js",
        "utils/domParser.js",
        "utils/storage.js",
        "utils/dateHelpers.js",
        "utils/uiHelpers.js",
        "utils/banner.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "action": {
    "default_popup": "menu/index.html",
    "default_title": "Show Me The Money"
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "themes.json",
        "teachMode.js",
        "teachTooltip.js",
        "teachTooltip.css",
        "utils/tableParser.js",
        "assets/icons/3dot.svg"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
