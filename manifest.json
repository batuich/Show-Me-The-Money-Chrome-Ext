{
  "manifest_version": 3,
  "name": "Cursor Spends Lite",
  "version": "0.1.1",
  "description": "Summarizes credit usage on the Cursor site with a minimal interface.",
  "permissions": [],
  "content_scripts": [
    {
      "matches": [
        "https://cursor.com/dashboard*"
      ],
      "js": [
        "utils/storage.js",
        "utils/dateHelpers.js",
        "utils/format.js",
        "utils/uiHelpers.js",
        "core/domParser.js",
        "ui/calendar.js",
        "ui/createPanel.js",
        "core/content.js"
      ],
      "css": []
    }
  ],
  "web_accessible_resources": [{
    "resources": [
      "config.json",
      "themes.json",
      "assets/icons/arrow-down.svg",
      "assets/icons/eye-open.svg",
      "assets/icons/eye-closed.svg"
    ],
    "matches": ["https://cursor.com/*"]
  }],
  "action": {
    "default_popup": "ui/menu/index.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  }
}
