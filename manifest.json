{
  "manifest_version": 3,
  "name": "Show Me The Money",
  "version": "1.0",
  "description": "Automatically summarizes credit usage on specified websites.",
  "permissions": [
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://cursor.com/spending",
        "https://cursor.com/dashboard*"
      ],
      "js": [
        "loader.js"
      ],
      "css": []
    }
  ],
  "web_accessible_resources": [{
    "resources": [
      "config.json",
      "themes.json",
      "assets/icons/arrow-down.svg",
      "assets/icons/eye-open.svg",
      "assets/icons/eye-closed.svg",
      "core/init.js",
      "core/main.js",
      "core/observer.js",
      "ui/panel.js",
      "ui/calendar.js",
      "ui/theme.js",
      "utils/date.js",
      "utils/dom.js",
      "utils/storage.js"
    ],
    "matches": ["<all_urls>"]
  }],
  "action": {
    "default_popup": "ui/menu/index.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  }
}
