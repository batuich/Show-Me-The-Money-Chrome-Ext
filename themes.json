{
	"teachMode": {
		"tableOutline": {
			"border": "2px dashed #007bff",
			"borderRadius": "8px",
			"boxShadow": "0 4px 12px rgba(0, 123, 255, 0.25)",
			"transition": "box-shadow 0.3s ease-in-out"
		},
		"colPreHighlightBg": "rgba(255, 235, 59, 0.2)",
		"colPreHighlightBorder": "1px dotted #FFEB3B",
		"colHoverBg": "rgba(255, 235, 59, 0.4)",
		"colHoverBorder": "1px solid #FFEB3B",
		"colSelectedUniqueBg": "rgba(74, 144, 226, 0.25)",
		"colSelectedValueBg": "rgba(245, 166, 35, 0.25)",
		"transition": "all 0.2s ease-in-out",
		"preColumnBase": {
			"background": "rgba(128, 128, 128, 0.1)",
			"border": "1px dotted #ccc"
		},
		"preColumnAmbiguous": {
			"background": "rgba(255, 193, 7, 0.2)",
			"border": "1px dotted #FFC107"
		},
		"preColumnValueCandidate": {
			"background": "rgba(245, 166, 35, 0.3)",
			"border": "1px solid #F5A623"
		},
		"preColumnUniqueCandidate": {
			"background": "rgba(74, 144, 226, 0.3)",
			"border": "1px solid #4A90E2"
		},
		"tableOutlineStrong": {
			"border": "3px solid #0056b3",
			"boxShadow": "0 6px 15px rgba(0, 86, 179, 0.4)"
		}
	},
	"cursor": {
		"base": {
			"default": {
				"fontFamily": "'Inter', 'SF Pro Text', sans-serif"
			}
		},
		"common": {
			"spacing": "4px"
		},
		"labels": {
			"missingData": {
				"text": "Not enough data for selected period"
			}
		},
		"highlight": {
			"default": {
				"border": "2px solid #4A90E2",
				"background": "rgba(74, 144, 226, 0.1)",
				"transition": "all 0.2s ease-in-out"
			}
		},
		"panel": {
			"default": {
				"backgroundColor": "#17181C",
				"border": "none",
				"color": "#FFF",
				"padding": "2px",
				"borderRadius": 6,
				"fontSize": 13
			}
		},
		"dragHandle": {
			"default": {
				"backgroundColor": "#1E1F23",
				"padding": "8px 2px",
				"borderRadius": 4
			},
			"hover": {
				"backgroundColor": "#26282E"
			}
		},
		"dragHandleDot": {
			"default": {
				"backgroundColor": "#5D5D5D"
			},
			"hover": {
				"backgroundColor": "#999"
			}
		},
		"button": {
			"default": {
				"backgroundColor": "transparent",
				"color": "#B5B5B6",
				"padding": "6px 10px",
				"borderRadius": 4
			},
			"hover": {
				"backgroundColor": "#1e1f23",
				"color": "#fff"
			},
			"active": {
				"backgroundColor": "#1e1f23",
				"color": "#fff"
			}
		},
		"totalBlock": {
			"default": {
				"backgroundColor": "#1E1F23",
				"borderRadius": 4,
				"padding": "6px 10px"
			}
		},
		"totalLabel": {
			"default": {
				"color": "#FFF",
				"fontWeight": 400
			}
		},
		"totalValue": {
			"default": {
				"color": "#878787",
				"fontWeight": 400
			}
		},
		"missingDataContainer": {
			"default": {}
		},
		"missingDataLabel": {
			"default": {
				"color": "#ff5555",
				"fontSize": 12,
				"fontWeight": 400,
				"textAlign": "center"
			}
		},
		"tooltip": {
			"default": {
				"backgroundColor": "#1E1F23",
				"color": "#fff",
				"fontSize": 12,
				"padding": "4px 4px",
				"borderRadius": 4
			}
		}
	}
}
