					"alignItems": "center",
					"justifyContent": "center"
				},
				"hover": {
					"backgroundColor": "rgba(45, 43, 35, 1)"
				}
			},
			"week": {
				"default": {
					"display": "flex",
					"justifyContent": "space-between",
					"alignItems": "center",
					"gap": "13px",
