{
	"cursor": {
		"base": {
			"default": {
				"fontFamily": "'Inter', 'SF Pro Text', sans-serif"
			}
		},
		"common": {
			"spacing": "8px"
		},
		"labels": {
			"missingData": {
				"text": "Not enough data for selected period"
			}
		},
		"panel": {
			"default": {
				"backgroundColor": "#17181C",
				"border": "none",
				"color": "#FFF",
				"padding": "2px",
				"borderRadius": 6,
				"fontSize": 13
			}
		},
		"dragHandle": {
			"default": {
				"backgroundColor": "#1E1F23",
				"padding": "5px",
				"borderRadius": 4
			},
			"hover": {
				"backgroundColor": "#26282E"
			}
		},
		"dragHandleDot": {
			"default": {
				"backgroundColor": "#5D5D5D"
			},
			"hover": {
				"backgroundColor": "#999"
			}
		},
		"button": {
			"default": {
				"backgroundColor": "transparent",
				"color": "#B5B5B6",
				"padding": "5px 10px",
				"borderRadius": 4
			},
			"hover": {
				"backgroundColor": "#1e1f23",
				"color": "#fff"
			},
			"active": {
				"backgroundColor": "#1e1f23",
				"color": "#fff"
			}
		},
		"datePicker": {
			"default": {
				"backgroundColor": "transparent",
				"border": "1px solid #333537",
				"color": "#FFF",
				"padding": "4px 10px",
				"borderRadius": 4
			},
			"hover": {
				"backgroundColor": "#1E1F23",
				"border": "1px solid #333537"
			}
		},
		"calendar": {
			"default": {
				"backgroundColor": "#1c1c1c",
				"border": "1px solid #2a2a2a",
				"borderRadius": 6,
				"padding": "10px"
			}
		},
		"calendarInput": {
			"default": {
				"backgroundColor": "#2b2b2b",
				"color": "#e0e0e0",
				"border": "1px solid #3a3a3a",
				"borderRadius": 4,
				"padding": "5px"
			}
		},
		"totalBlock": {
			"default": {
				"backgroundColor": "#1E1F23",
				"borderRadius": 4,
				"padding": "5px 10px"
			}
		},
		"totalLabel": {
			"default": {
				"color": "#FFF",
				"fontWeight": 400
			}
		},
		"totalValue": {
			"default": {
				"color": "#878787",
				"fontWeight": 400
			}
		},
		"missingDataContainer": {
			"default": {
				"marginTop": "6px"
			}
		},
		"missingDataLabel": {
			"default": {
				"color": "#ff5555",
				"fontSize": 12,
				"fontWeight": 400,
				"textAlign": "center"
			}
		},
		"tooltip": {
			"default": {
				"backgroundColor": "#333",
				"color": "#fff",
				"fontSize": 12,
				"padding": "8px 10px",
				"borderRadius": 6
			}
		}
	}
}