			"menuHelpText": {
				"default": {
					"color": "#B5B5B6",
					"fontSize": 12,
					"lineHeight": 1.4,
					"padding": "0px 6px",
					"fontFamily": "'Inter', 'SF Pro Text', sans-serif"
				}
			}
