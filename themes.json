{
  "cursor": {
    "common": {
      "fontFamily": "'Inter', 'SF Pro Text', sans-serif",
      "fontSize": "13px",
      "radius": "8px",
      "spacing": "8px"
    },
    "panel": {
      "bg": "#1c1c1c",
      "border": "1px solid #2a2a2a",
      "textColor": "#e0e0e0",
      "padding": "4px"
    },
    "dragHandle": {
      "dotsColor": "#666",
      "hoverColor": "#999"
    },
    "button": {
      "default": {
        "bg": "transparent",
        "text": "#e0e0e0",
        "padding": "4px 8px"
      },
      "hover": {
        "bg": "#2b2b2b",
        "text": "#fff"
      },
      "active": {
        "bg": "#333333",
        "text": "#fff"
      }
    },
    "datePicker": {
      "bg": "transparent",
      "border": "1px solid #3a3a3a",
      "text": "#e0e0e0",
      "padding": "4px 8px",
      "hover": {
        "bg": "#2b2b2b",
        "border": "1px solid #4a4a4a"
      },
      "calendar": {
        "bg": "#1c1c1c",
        "border": "1px solid #2a2a2a",
        "inputBg": "#2b2b2b",
        "inputText": "#e0e0e0",
        "applyButtonBg": "#333",
        "applyButtonText": "#fff"
      }
    },
    "totalDisplay": {
      "bg": "#2b2b2b",
      "text": "#e0e0e0",
      "valueWeight": "700",
      "padding": "4px 8px"
    },
    "labels": {
      "missingData": {
        "color": "#ff5555",
        "fontSize": "12px",
        "fontFamily": "'Inter', 'SF Pro Text', sans-serif"
      }
    },
    "tooltip": {
      "default": {
        "bg": "#333",
        "text": "#fff",
        "fontSize": "12px"
      }
    }
  },
  "dark": {
    "common": {
      "radius": "8px",
      "padding": "6px"
    },
    "button": {
      "default": {
        "bg": "#333",
        "text": "#fff"
      },
      "hover": {
        "bg": "#444"
      }
    },
    "panel": {
      "default": {
        "bg": "#222",
        "border": "#333",
        "text": "#fff"
      }
    },
    "tooltip": {
      "default": {
        "bg": "#ff3333",
        "text": "#fff",
        "fontSize": "12px"
      }
    },
    "labels": {
      "missingData": {
        "text": "Not enough data for selected period",
        "color": "#ff5555",
        "fontSize": "12px",
        "position": "belowTotal"
      }
    }
  },
  "light": {
    "common": {
      "radius": "8px",
      "padding": "6px"
    },
    "button": {
      "default": {
        "bg": "#eee",
        "text": "#000"
      },
      "hover": {
        "bg": "#ddd"
      }
    },
    "panel": {
      "default": {
        "bg": "#fff",
        "border": "#ccc",
        "text": "#000"
      }
    },
    "tooltip": {
      "default": {
        "bg": "#ff3333",
        "text": "#fff",
        "fontSize": "12px"
      }
    },
    "labels": {
      "missingData": {
        "text": "Not enough data for selected period",
        "color": "#ff0000",
        "fontSize": "12px",
        "position": "belowTotal"
      }
    }
  }
}
