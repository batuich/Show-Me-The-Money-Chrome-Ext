{
  "cursor": {
    "base": {
      "default": {
        "fontFamily": "'Inter', 'SF Pro Text', sans-serif"
      }
    },
    "common": {
        "spacing": "8px"
    },
    "labels": {
        "missingData": {
            "text": "Not enough data for selected period"
        }
    },
    "panel": {
      "default": {
        "backgroundColor": "#1c1c1c",
        "border": "1px solid #2a2a2a",
        "color": "#e0e0e0",
        "padding": "4px",
        "borderRadius": 8,
        "fontSize": 13
      }
    },
    "dragHandle": {
      "default": {
        "backgroundColor": "#1e1e1e",
        "borderRadius": 6
      },
      "hover": {
        "backgroundColor": "#2a2a2a"
      }
    },
    "dragHandleDot": {
        "default": {
            "backgroundColor": "#666"
        },
        "hover": {
            "backgroundColor": "#999"
        }
    },
    "button": {
      "default": {
        "backgroundColor": "transparent",
        "color": "#e0e0e0",
        "padding": "4px 8px",
        "borderRadius": 6
      },
      "hover": {
        "backgroundColor": "#2b2b2b",
        "color": "#fff"
      },
      "active": {
        "backgroundColor": "#333333",
        "color": "#fff"
      }
    },
    "datePicker": {
      "default": {
        "backgroundColor": "transparent",
        "border": "1px solid #3a3a3a",
        "color": "#e0e0e0",
        "padding": "8px 10px",
        "borderRadius": 6
      },
      "hover": {
        "backgroundColor": "#2b2b2b",
        "border": "1px solid #4a4a4a"
      }
    },
    "calendar": {
        "default": {
            "backgroundColor": "#1c1c1c",
            "border": "1px solid #2a2a2a",
            "borderRadius": 6,
            "padding": "10px"
        }
    },
    "calendarInput": {
        "default": {
             "backgroundColor": "#2b2b2b",
             "color": "#e0e0e0",
             "border": "1px solid #3a3a3a",
             "borderRadius": 4,
             "padding": "5px"
        }
    },
    "totalBlock": {
      "default": {
        "backgroundColor": "#2a2a2a",
        "borderRadius": 6,
        "padding": "4px 10px"
      }
    },
    "totalLabel": {
        "default": {
            "color": "#ccc",
            "fontWeight": 400
        }
    },
    "totalValue": {
        "default": {
            "color": "#fff",
            "fontWeight": 700
        }
    },
    "missingDataContainer": {
      "default": {
        "marginTop": "6px"
      }
    },
    "missingDataLabel": {
      "default": {
        "color": "#ff5555",
        "fontSize": 12,
        "fontWeight": 400,
        "textAlign": "center"
      }
    },
    "tooltip": {
      "default": {
        "backgroundColor": "#333",
        "color": "#fff",
        "fontSize": 12,
        "padding": "8px 10px",
        "borderRadius": 6
      }
    }
  }
}
