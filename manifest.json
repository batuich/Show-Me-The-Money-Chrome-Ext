{
  "manifest_version": 3,
  "name": "Show Me The Money",
  "version": "1.0",
  "description": "Automatically summarizes credit usage on specified websites.",
  "permissions": [
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://cursor.com/spending",
        "https://cursor.com/dashboard*"
      ],
      "js": [
        "utils/storage.js",
        "utils/domParser.js",
        "utils/dateHelpers.js",
        "utils/uiHelpers.js",
        "content.js"
      ],
      "css": []
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "themes.json",
        "assets/icons/arrow-down.svg",
        "assets/icons/eye-open.svg",
        "assets/icons/eye-closed.svg"
      ],
      "matches": [
        "https://cursor.com/*"
      ]
    }
  ],
  "action": {
    "default_popup": "menu/index.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  }
}
