{
	"teachMode": {
		"tableOutline": {
			"border": "2px dashed #007bff",
			"borderRadius": "8px",
			"boxShadow": "0 4px 12px rgba(0, 123, 255, 0.25)",
			"transition": "box-shadow 0.3s ease-in-out"
		},
		"tableOutlineStrong": {
			"border": "3px solid #0056b3",
			"boxShadow": "0 6px 15px rgba(0, 86, 179, 0.4)"
		},
		"transition": "all 0.2s ease-in-out",
		"colBaseHighlight": "rgba(255, 230, 150, 0.30)",
		"colUniqueHighlight": "rgba(100, 200, 255, 0.40)",
		"colValueHighlight": "rgba(255, 180, 120, 0.40)",
		"highlightBorder": "2px solid rgba(0, 0, 0, 0.20)"
	},
	"cursor": {
		"base": {
			"default": {
				"fontFamily": "'Inter', 'SF Pro Text', sans-serif"
			}
		},
		"common": {
			"spacing": "4px"
		},
		"labels": {
			"missingData": {
				"text": "Not enough data for selected period"
			}
		},
		"highlight": {
			"default": {
				"border": "2px solid #4A90E2",
				"background": "rgba(74, 144, 226, 0.1)",
				"transition": "all 0.2s ease-in-out"
			}
		},
		"panel": {
			"default": {
				"backgroundColor": "#13120A",
				"border": "none",
				"color": "#FFF",
				"padding": "2px",
				"borderRadius": 6,
				"fontSize": 13
			}
		},
		"dragHandle": {
			"default": {
				"backgroundColor": "#1E1C15",
				"padding": "8px 2px",
				"borderRadius": 4
			},
			"hover": {
				"backgroundColor": "#25231C"
			}
		},
		"dragHandleDot": {
			"default": {
				"backgroundColor": "#5D5D5D"
			},
			"hover": {
				"backgroundColor": "#999"
			}
		},
		"button": {
			"default": {
				"backgroundColor": "transparent",
				"color": "#B5B5B6",
				"padding": "6px 10px",
				"borderRadius": 4
			},
			"hover": {
				"backgroundColor": "#25231C",
				"color": "#fff"
			},
			"active": {
				"backgroundColor": "#1E1C15",
				"color": "#fff"
			}
		},
		"totalBlock": {
			"default": {
				"backgroundColor": "#1E1C15",
				"borderRadius": 4,
				"padding": "6px 10px"
			}
		},
		"totalLabel": {
			"default": {
				"color": "#FFF",
				"fontWeight": 400
			}
		},
		"totalValue": {
			"default": {
				"color": "#878787",
				"fontWeight": 400
			}
		},
		"missingDataContainer": {
			"default": {}
		},
		"missingDataLabel": {
			"default": {
				"color": "#ff5555",
				"fontSize": 12,
				"fontWeight": 400,
				"textAlign": "center"
			}
		},
		"tooltip": {
			"default": {
				"backgroundColor": "#1E1C15",
				"color": "#fff",
				"fontSize": 12,
				"padding": "4px 4px",
				"borderRadius": 4,
				"fontFamily": "'Inter', 'SF Pro Text', sans-serif"
			}
		}
	},
